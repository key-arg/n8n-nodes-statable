{
	"name": "n8n-nodes-statable",
	"version": "0.1.1",
	"description": "n8n node for Statable, privacy-first cookieless web analytics. Query visitors, sources, pages, goals and funnels in your workflows.",
	"license": "MIT",
	"homepage": "https://github.com/key-arg/n8n-nodes-statable#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"statable",
		"analytics",
		"web-analytics",
		"privacy",
		"cookieless"
	],
	"author": {
		"name": "Key Arg B.V.",
		"email": "support@statable.com",
		"url": "https://statable.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/key-arg/n8n-nodes-statable.git"
	},
	"bugs": {
		"url": "https://github.com/key-arg/n8n-nodes-statable/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/StatableApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Statable/Statable.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
